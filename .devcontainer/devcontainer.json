{
  "name": "Kafka Buslines Event Streaming",
  "customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"ms-azuretools.vscode-docker",
				"ms-python.autopep8",
				"ms-python.pylint",
				"analytic-signal.preview-pdf",
				"grapecity.gc-excelviewer",
				"github.copilot",
				"github.copilot-chat",
				"mechatroner.rainbow-csv"
			],
			"settings": {
				"workbench.colorTheme": "Default Dark+",
				"editor.rulers": [80],
				"workbench.iconTheme": "vs-seti"
			}
		}
	},
  "forwardPorts": [
    9092,
    2181
  ],
  "remoteUser": "root"
}
